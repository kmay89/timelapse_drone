{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh",
            "timeout": 420
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run vantage *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run python scripts/budgets.py *)",
      "Bash(uv run python -m vantage.demo.synth *)",
      "Bash(npx playwright test *)",
      "Bash(npm run test:web*)",
      "Bash(ffprobe *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
