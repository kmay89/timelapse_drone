# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/

# Node / Playwright
node_modules/
web-tests/.results/
playwright-report/
test-results/

# Vantage: raw footage and heavy intermediates never go in git
**/footage/
**/work/
dist/

# Client projects never enter this public repo (CLAUDE.md invariant 1): only the fictional demo is
# tracked under projects/, and a project folder dropped at the top level keeps its YAML, facts, brand
# files and masters out of `git add -A`.
/projects/*
!/projects/demo-lakeside/
/*/project.yaml
/*/story.yaml
/*/facts.yaml
/*/brand/
/*/masters/

# Demo masters are regenerated from synthetic footage in CI
projects/demo-lakeside/masters/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code workflow worktrees (scratch checkouts of this repo)
.claude/worktrees/
